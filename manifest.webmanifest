{
  "name": "PrePro: from idea to finished song",
  "short_name": "PrePro",
  "description": "Record ideas anywhere, then edit, mix and finish the song. A multitrack studio for songwriters and engineers.",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
